#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# Block committing raw run dumps, partials, logs, or secrets
BAD=$(git diff --cached --name-only | grep -E '^(runs/|runs_v4/)|\.partial\.json$|\.log$|\.env|\.redact\.local|secret|token' || true)
if [ -n "$BAD" ]; then
  echo "ERROR: Refusing to commit raw runs/logs/secrets:" >&2
  echo "$BAD" >&2
  exit 1
fi
python3 "$ROOT/scripts/publish.py"
